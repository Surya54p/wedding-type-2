generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guestbook {
  id         String   @id @default(cuid())
  name       String
  attendance String   @default("Akan Hadir")
  message    String?
  createdAt  DateTime @default(now())
}
